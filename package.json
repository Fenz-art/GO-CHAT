{
  "name": "go-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GOCHAT_ALLOW_EMBEDDED_PREVIEW=1 NODE_ENV=production sh -c 'pnpm build:frontend && go run ./backend/cmd/server'",
    "build:frontend": "NODE_ENV=production next build",
    "build": "NODE_ENV=production pnpm build:frontend && mkdir -p dist && go build -o dist/gochat ./backend/cmd/server",
    "start": "./dist/gochat",
    "db:migrate": "go run ./backend/cmd/migrate",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "go:test": "go test ./...",
    "sqlc:generate": "PATH=/home/ubuntu/go/bin:$PATH sqlc generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.90.2",
    "framer-motion": "^12.23.22",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.453.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vitest": "^2.1.4",
    "ws": "^8.21.3"
  },
  "packageManager": "pnpm@10.4.1"
}
